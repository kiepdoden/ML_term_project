FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 iputils-ping curl nftables && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir duckdb==1.4.1 "mcp[cli]==1.20.0" "pydantic==2.11.9" uvicorn httpx pandas numpy scikit-learn lightgbm openai
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
